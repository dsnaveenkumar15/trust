# Shared by web and batch. Copy to .env. Trust serves only TRUST_HOST; the other hosts are used for footer links.
TRUST_HOST=trust.naveenlabs.tech
RADAR_HOST=radar.naveenlabs.tech
BLUEPRINTS_HOST=blueprints.naveenlabs.tech
PUBLIC_SCHEME=https
PUBLIC_PORT=
ADMIN_USER=owner
# 16+ characters; /admin is disabled (404) while this is the default or shorter.
ADMIN_PASSWORD=change-me
PLANET_MODULES=trust.jobs
TRUST_MODEL=sonnet
WEIGHTS=trust=100
KUMA_PUSH_URL=
# Where readers can dispute a Trust finding (an issue tracker, a form or a mailto: link). Hidden when empty.
DISPUTE_URL=
# Where Radar's published data is read from (servers Radar reports as new). Defaults to DATA_ROOT; docker-compose.siblings.yml
# mounts the Radar app's data volume read-only at this path.
# RADAR_DATA_ROOT=/radar-data/published

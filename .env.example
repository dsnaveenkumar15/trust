# Shared by web and batch. Copy to .env. Trust serves only TRUST_HOST; the other hosts are used for footer links.
TRUST_HOST=trust.naveenlabs.tech
RADAR_HOST=radar.naveenlabs.tech
BLUEPRINTS_HOST=blueprints.naveenlabs.tech
PUBLIC_SCHEME=https
PUBLIC_PORT=
ADMIN_USER=owner
# 16+ characters; /admin is disabled (404) while this is the default or shorter.
ADMIN_PASSWORD=change-me
PLANET_MODULES=trust.jobs
TRUST_MODEL=sonnet
WEIGHTS=trust=100
KUMA_PUSH_URL=
# Where readers can dispute a Trust finding (an issue tracker, a form or a mailto: link). Hidden when empty.
DISPUTE_URL=
# Where Radar's published data is read from (servers Radar reports as new). Defaults to DATA_ROOT; docker-compose.siblings.yml
# mounts the Radar app's data volume read-only at this path.
# RADAR_DATA_ROOT=/radar-data/published
# Red team agent (/redteam). Off unless REDTEAM_ENABLED=1 with a key and at least one fast model. OpenRouter ids,
# primary first: FAST models play the victim, STRONG models are the analyst. GITHUB_TOKEN (read-only) raises the
# GitHub limit for repo runs; without it the anonymous limit applies.
REDTEAM_ENABLED=0
OPENROUTER_API_KEY=
REDTEAM_FAST_MODELS=deepseek/deepseek-v4.1-flash
REDTEAM_STRONG_MODELS=z-ai/glm-5.3-flash
REDTEAM_STRONG_EFFORT=low
REDTEAM_PRICES=
REDTEAM_RUN_USD=0.10
REDTEAM_DAILY_USD=0.25
REDTEAM_RUN_SECONDS=600
GITHUB_TOKEN=
